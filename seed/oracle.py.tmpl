"""Oracle for the {{FH_PROJECT}} variant search (Layer 2).

Skeleton stamped by `gategraph init` because loop.enabled was set. `run_gates` is the only method
the search requires. The kernel Oracle ABC in core/kernel/oracle.py defaults `incumbent()` to None
and `proposal_space()` / `soft_passes()` to []; override them only if your project uses them.
The search refuses to start until run_gates returns real passes for the gates declared in
adapter.yaml loop.gates.metric_floors.
"""

from core.kernel.oracle import Oracle as KernelOracle
from core.kernel.oracle import OracleGateResult

# THE CONTRACT (F3 pattern: keep enforced spec and narrated spec identical):
# the domain and probes below are the REAL variant contract. run_gates MUST
# sample from CONTRACT (including every boundary probe), and any variant
# guide you write MUST print CONTRACT instead of restating it by hand. The
# consumer-D consumer graduated a variant that violated its written contract
# because the oracle grid never crossed a documented boundary. An explicit
# CONTRACT block consumed by both sides makes that drift impossible.
CONTRACT = {
    # Evaluation domain: variants must behave on ALL of it, edges included.
    "domain": (0.0, 1.0),
    # Probes the grid must contain EXACTLY, put every documented boundary
    # and known corner case here, not just interior samples.
    "boundary_probes": [0.0, 1.0],
}


class Oracle(KernelOracle):
    """Project-specific evaluation authority for search variants."""

    def run_gates(self, variant_path, cfg) -> OracleGateResult:
        """Evaluate one variant; return an OracleGateResult
        (variant_id, passes, metrics, tripwires, notes).

        The oracle computes every metric itself: a variant never reports its own score.
        Sample the evaluation grid from CONTRACT["domain"] and include every
        CONTRACT["boundary_probes"] point explicitly.
        """
        raise NotImplementedError("implement harness/adapter/oracle.py: run_gates()")
